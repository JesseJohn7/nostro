{
  "name": "@nostro-labs/client",
  "version": "0.1.0",
  "description": "A browser-safe TypeScript client for the nostro HTTP API.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostro-labs/nostro.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/nostro-labs/nostro/tree/main/packages/client",
  "bugs": {
    "url": "https://github.com/nostro-labs/nostro/issues"
  },
  "keywords": [
    "stellar",
    "reconciliation",
    "payments",
    "api",
    "client"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nostro-labs/nostro": "workspace:^"
  },
  "devDependencies": {
    "@nostro-labs/server": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
